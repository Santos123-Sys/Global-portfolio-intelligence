# Railway Postgres or any standard PostgreSQL database.
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-characters"
MFA_ENCRYPTION_KEY="replace-with-a-different-32-character-secret"
PUBLIC_APP_URL="https://portfolio.example.com"
GOOGLE_TRANSLATE_API_KEY=""

# Market data and on-demand company resolution.
# Financial Modeling Prep is the primary cross-market provider for prices,
# company profiles, financial statements and arbitrary company/ticker lookup.
MARKET_DATA_PROVIDER="fmp"
FMP_API_KEY=""
# Kept for other optional connectors that may still use a generic key.
MARKET_DATA_API_KEY=""

# Broad discovery. B3 uses BRAPI_API_KEY when configured; other markets use the
# selected provider. FMP can also serve as the explicit fallback.
DISCOVERY_PROVIDER="fmp"
DISCOVERY_FALLBACK_PROVIDER="fmp"
FINNHUB_API_KEY=""
BRAPI_API_KEY=""
DISCOVERY_UNIVERSE_CACHE_HOURS="168"
# MARKET_DATA_GATEWAY_CALLS_PER_MINUTE="60"
# MARKET_DATA_GATEWAY_CALLS_PER_DAY="2000"
# MARKET_DATA_GATEWAY_PLAN_LIMIT_MEMORY_HOURS="24"

WEB_SEARCH_PROVIDER="tavily"
WEB_SEARCH_API_KEY=""
