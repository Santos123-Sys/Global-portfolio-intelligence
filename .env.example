# Keep existing login credentials and secrets. Do not use example values in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gpi
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
PUBLIC_APP_URL=http://localhost:3000
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Portfolio Owner

# FilingLens is unchanged by this repository replacement. Enable only after its
# public read contract is actually deployed and a dedicated token is provisioned.
FILINGLENS_READ_ENABLED=false
FILINGLENS_API_URL=
FILINGLENS_READ_API_TOKEN=
FILINGLENS_ISSUER_MAP_JSON={}

# Optional, off by default. Choose a compatible model explicitly; no paid tests.
RESEARCH_MODEL_ENABLED=false
RESEARCH_MODEL_API_KEY=
RESEARCH_MODEL_NAME=
