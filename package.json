{
  "name": "gpi-foundation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start",
    "start:standalone": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint src scripts tests e2e next.config.ts playwright.config.ts playwright.production.config.ts vitest.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "db:migrate": "node --import tsx scripts/migrate-foundation.ts",
    "admin:create": "node --import tsx scripts/create-admin.ts",
    "admin:create:if-configured": "node --import tsx scripts/create-admin.ts --if-configured",
    "worker": "node --import tsx scripts/foundation-worker.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "start:worker": "node dist/foundation-worker.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swr": "^2.5.1",
    "tsx": "^4.23.15",
    "zod": "^3.24.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
